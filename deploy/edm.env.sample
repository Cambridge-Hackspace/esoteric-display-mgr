# Settings for the Esoteric Display Manager.
#
# Everything that differs from one deployment to the next is set here, so the
# source never has to be edited on a server. Plain NAME=value lines: no
# "export", no spaces around "=".
#
# On FreeBSD, install as /usr/local/etc/edm.env for deploy/freebsd/rc.d/edm.
# Whatever reads it, it holds the secret key: owned by root, mode 600.

# --- required ---------------------------------------------------------------

# The SQLite database.
DATABASE_PATH=/usr/local/edm/db/edm.db

# Signs and encrypts sessions. Changing it logs everyone out.
# Generate one with: mix phx.gen.secret
SECRET_KEY_BASE=

# --- where it listens -------------------------------------------------------

PORT=4000

# The address to listen on. The default, ::, is the IPv6 wildcard, which on
# most systems takes IPv4 connections as well. Set 0.0.0.0 where it does not
# (a BSD with net.inet6.ip6.v6only=1, or a host with IPv6 switched off), or
# 127.0.0.1 to be reachable only through a proxy on the same machine.
#PHX_BIND=::

# --- how the outside world reaches it ---------------------------------------
# These shape the links the app generates. They do not open any ports.

PHX_HOST=edm.example.org
#PHX_URL_PORT=443
#PHX_URL_SCHEME=https

# Requests arriving over plain http are redirected to https, except for these
# hosts. A proxy that terminates TLS should send X-Forwarded-Proto instead of
# being listed here.
#PHX_SSL_EXCLUDE_HOSTS=localhost,127.0.0.1
