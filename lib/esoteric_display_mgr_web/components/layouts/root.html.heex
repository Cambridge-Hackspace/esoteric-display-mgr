<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="EsotericDisplayMgr" suffix=" · Phoenix Framework" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body class="bg-base-100 text-base-content h-screen flex flex-col overflow-hidden">
    <div class="navbar bg-base-100/95 backdrop-blur border-b border-base-200 sticky top-0 z-30 px-2 sm:px-4 lg:px-8 flex-none">
      <div :if={@current_scope} class="flex-none lg:hidden">
        <label for="main-drawer" aria-label="open sidebar" class="btn btn-square btn-ghost">
          <.icon name="hero-bars-3" class="size-6" />
        </label>
      </div>
      <div class="flex-1 flex items-center pl-2 lg:pl-0">
        <img
          src={~p"/images/chack_logo.svg"}
          alt="Cambridge Hackspace"
          class="h-8 w-8 mr-2 sm:mr-3"
        />
        <a
          href="/"
          class="text-lg sm:text-xl font-bold text-base-content hover:opacity-80 transition-opacity"
        >
          Esoteric Display Manager
        </a>
      </div>
      <div class="flex-none">
        <div class="dropdown dropdown-end md:hidden">
          <label tabindex="0" class="btn btn-ghost btn-circle">
            <.icon name="hero-ellipsis-vertical" class="size-6" />
          </label>
          <ul
            tabindex="0"
            class="menu menu-sm dropdown-content mt-3 z-[1] p-2 shadow bg-base-100 rounded-box w-52 border border-base-200"
          >
            <li><a href="https://www.cambridgehackspace.com" target="_blank">Website</a></li>
            <li><a href="https://github.com/Cambridge-Hackspace" target="_blank">GitHub</a></li>

            <div class="divider my-1"></div>

            <div class="px-2 py-1"><.theme_toggle /></div>

            <div class="divider my-1"></div>

            <li :if={@current_scope}>
              <span class="font-medium text-xs truncate">{@current_scope.user.email}</span>
            </li>
            <li :if={@current_scope}><.link href={~p"/users/settings"}>Settings</.link></li>
            <li :if={@current_scope}>
              <.link href={~p"/users/log-out"} method="delete" class="text-error">Log out</.link>
            </li>

            <li :if={!@current_scope}><.link href={~p"/users/register"}>Register</.link></li>
            <li :if={!@current_scope}>
              <.link href={~p"/users/log-in"} class="text-primary">Log in</.link>
            </li>
          </ul>
        </div>

        <ul class="menu menu-horizontal px-1 gap-2 items-center hidden md:flex">
          <li>
            <a
              href="https://www.cambridgehackspace.com"
              target="_blank"
              class="hover:text-primary transition-colors"
            >
              Website
            </a>
          </li>
          <li>
            <a
              href="https://github.com/Cambridge-Hackspace"
              target="_blank"
              class="hover:text-primary transition-colors"
            >
              GitHub
            </a>
          </li>

          <div class="divider divider-horizontal mx-0"></div>

          <li><.theme_toggle /></li>

          <div class="divider divider-horizontal mx-0"></div>

          <li :if={@current_scope} class="flex items-center">
            <span class="text-sm font-medium opacity-80 py-2">{@current_scope.user.email}</span>
          </li>
          <li :if={@current_scope}>
            <.link href={~p"/users/settings"} class="hover:text-primary transition-colors">
              Settings
            </.link>
          </li>
          <li :if={@current_scope}>
            <.link
              href={~p"/users/log-out"}
              method="delete"
              class="btn btn-sm btn-error btn-outline mt-1 ml-2"
            >
              Log out
            </.link>
          </li>

          <li :if={!@current_scope}>
            <.link href={~p"/users/register"} class="hover:text-primary transition-colors">
              Register
            </.link>
          </li>
          <li :if={!@current_scope}>
            <.link href={~p"/users/log-in"} class="btn btn-sm btn-primary mt-1 ml-2">
              Log in
            </.link>
          </li>
        </ul>
      </div>
    </div>

    <div :if={@current_scope} class="drawer lg:drawer-open flex-1 min-h-0">
      <input id="main-drawer" type="checkbox" class="drawer-toggle" />

      <main class="drawer-content flex flex-col overflow-y-auto h-full relative">
        <main class="flex-1 p-4 sm:p-6 lg:p-8 flex flex-col min-h-full">
          <div class="flex-1">
            {@inner_content}
          </div>
        </main>
      </main>

      <div class="drawer-side z-40 lg:z-auto">
        <label for="main-drawer" aria-label="close sidebar" class="drawer-overlay"></label>
        <aside class="bg-base-200 w-64 min-h-full border-r border-base-300 flex flex-col">
          <div class="p-4 flex items-center justify-between lg:hidden border-b border-base-300">
            <span class="font-bold text-lg">Menu</span>
            <label for="main-drawer" class="btn btn-ghost btn-sm btn-square">
              <.icon name="hero-x-mark" class="size-5" />
            </label>
          </div>
          <ul
            class="menu p-4 w-full text-base-content flex-1 overflow-y-auto"
            onclick="document.getElementById('main-drawer').checked = false"
          >
            <li
              :if={
                EsotericDisplayMgr.Accounts.has_permission?(@current_scope, [
                  "users:manage",
                  "roles:manage"
                ])
              }
              class="menu-title"
            >
              Administration
            </li>
            <li :if={EsotericDisplayMgr.Accounts.has_permission?(@current_scope, "users:manage")}>
              <.link navigate={~p"/admin/users"}>
                <.icon name="hero-users" class="size-4" /> Users
              </.link>
            </li>
            <li :if={EsotericDisplayMgr.Accounts.has_permission?(@current_scope, "roles:manage")}>
              <.link navigate={~p"/admin/roles"}>
                <.icon name="hero-shield-check" class="size-4" /> Roles
              </.link>
            </li>

            <div
              :if={
                EsotericDisplayMgr.Accounts.has_permission?(@current_scope, [
                  "users:manage",
                  "roles:manage"
                ])
              }
              class="divider my-2"
            >
            </div>

            <li
              :if={
                EsotericDisplayMgr.Accounts.has_permission?(@current_scope, [
                  "displays:manage",
                  "displays:list",
                  "stream:connect",
                  "stream:manage"
                ])
              }
              class="menu-title"
            >
              Hardware
            </li>
            <li :if={
              EsotericDisplayMgr.Accounts.has_permission?(@current_scope, [
                "displays:manage",
                "displays:list"
              ])
            }>
              <.link navigate={~p"/admin/displays"}>
                <.icon name="hero-computer-desktop" class="size-4" /> Displays
              </.link>
            </li>
            <li :if={
              EsotericDisplayMgr.Accounts.has_permission?(@current_scope, [
                "stream:connect",
                "stream:manage"
              ])
            }>
              <.link navigate={~p"/admin/streams"}>
                <.icon name="hero-server-stack" class="size-4" /> Streams
              </.link>
            </li>

            <div
              :if={EsotericDisplayMgr.Accounts.has_permission?(@current_scope, ["media:manage"])}
              class="divider my-2"
            >
            </div>

            <li
              :if={EsotericDisplayMgr.Accounts.has_permission?(@current_scope, ["media:manage"])}
              class="menu-title"
            >
              Content
            </li>
            <li :if={
              EsotericDisplayMgr.Accounts.has_permission?(@current_scope, ["media:manage"])
            }>
              <.link navigate={~p"/admin/media"}>
                <.icon name="hero-photo" class="size-4" /> Media Library
              </.link>
            </li>
          </ul>
        </aside>
      </div>
    </div>

    <main
      :if={!@current_scope}
      class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 flex flex-col relative"
    >
      <div class="flex-1">
        {@inner_content}
      </div>
    </main>
    <footer class="py-2 border-t border-base-200 text-center text-xs text-base-content/60 z-50 bg-base-100 shrink-0">
      Built with love by the
      <a
        href="https://www.cambridgehackspace.com"
        target="_blank"
        class="link link-hover text-primary font-semibold"
      >
        Cambridge Hackspace
      </a>
    </footer>
  </body>
</html>
