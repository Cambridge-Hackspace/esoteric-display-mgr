<Layouts.flash_group flash={@flash} />
<div :if={@current_scope} class="prose max-w-none">
  <h1 class="text-3xl font-bold">Welcome to the Dashboard</h1>
  <p class="text-base-content/70">
    You are securely logged in as <strong>{@current_scope.user.email}</strong>.
    Use the sidebar navigation to manage users, assign roles, and configure your digital displays.
  </p>
</div>

<div :if={!@current_scope} class="hero min-h-[calc(100vh-4rem)] bg-base-200 rounded-box mt-4">
  <div class="hero-content flex-col lg:flex-row text-center lg:text-left gap-8 lg:gap-12">
    <img
      src={~p"/images/chack_logo.svg"}
      class="max-w-[12rem] lg:max-w-sm rounded-full shadow-2xl bg-base-100 p-4"
      alt="Cambridge Hackspace"
    />
    <div class="max-w-md">
      <h1 class="text-5xl font-bold">Esoteric Display Manager</h1>
      <p class="py-6 text-base-content/80">
        Manage your esoteric displays!
      </p>
      <div class="flex items-center justify-center lg:justify-start gap-4">
        <.link navigate={~p"/users/log-in"} class="btn btn-primary">Log In</.link>
        <.link navigate={~p"/users/register"} class="btn btn-ghost">Create an Account</.link>
      </div>
    </div>
  </div>
</div>
